# Copy to .env and fill in. Never commit the real .env.
PORT=5000
NODE_ENV=development
# Comma separated list of frontend origins allowed to call the API (CORS + cookies)
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/voltix

# Long random strings (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
OTP_HASH_SECRET=

# Used only by `node scripts/createAdmin.js` (password: minimum 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay: BOTH keys are needed for UPI / cards. Use rzp_test_ keys until KYC is done.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> add https://YOUR-API/api/payments/webhook (events: payment.captured, order.paid)
# and paste the secret you chose there. Without it the webhook is switched off.
RAZORPAY_WEBHOOK_SECRET=

# --- Production only ---
# Number of proxies in front of the app (Render/Railway/Nginx = 1). Needed so rate limits count real customers.
TRUST_PROXY=
# Leave empty if frontend and API share one domain. Use "none" only when they are on different domains (needs HTTPS).
COOKIE_SAME_SITE=
# Minutes before an unpaid online-payment order is cancelled (minimum 5, default 30)
ORDER_EXPIRY_MINUTES=30
