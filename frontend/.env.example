# Copy to .env. These values end up in the browser, so never put secrets here.
#
# The base URL is the bare origin of the API: http://localhost:5000, or
# https://your-domain.example. Do NOT append /api — every request already
# includes it (a trailing /api is ignored by src/config/api.js, but keep it clean).
VITE_API_URL=http://localhost:5000

# Google Cloud Console -> Credentials -> OAuth client.
# Add every origin you open the site from, e.g.:
#   http://localhost:5173
#   https://your-domain.example
VITE_GOOGLE_CLIENT_ID=
